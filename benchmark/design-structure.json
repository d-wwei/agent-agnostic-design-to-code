{
  "meta": {
    "app": "ACP Browser Client",
    "description": "Browser extension for connecting AI agents via Agent Communication Protocol",
    "theme": "dark",
    "font": "DM Sans",
    "iconSet": "lucide",
    "sourceFile": "/Users/eli/Downloads/pencil-new.pen"
  },
  "tokens": {
    "accent": "#6ee7b7",
    "accent-hover": "#5ddba8",
    "bg-card": "#1e2538",
    "bg-hover": "#252833",
    "bg-input": "#1a1d26",
    "bg-primary": "#0f1117",
    "border": "#ffffff2e",
    "border-card": "#ffffff30",
    "error": "#f87171",
    "success": "#6ee7b7",
    "text-muted": "#6b7280",
    "text-primary": "#d1d5db",
    "text-secondary": "#9ca3af",
    "user-bubble": "#0d3b3c",
    "warning": "#dcdcaa"
  },
  "screens": [
    {
      "id": "p9GF8",
      "name": "Welcome State",
      "dimensions": { "width": 400, "height": 780 },
      "structure": {
        "name": "root",
        "layout": "vertical",
        "children": [
          {
            "name": "TopBar",
            "layout": "horizontal",
            "justify": "space-between",
            "height": 48,
            "bg": "bg-card",
            "shadow": true,
            "children": [
              { "name": "agentSelector", "layout": "horizontal", "elements": ["icon", "agentName", "chevronDown"] },
              { "name": "rightActions", "layout": "horizontal", "elements": ["statusDot", "connectionIcon", "notificationIcon", "settingsIcon"] }
            ]
          },
          {
            "name": "EmptyContent",
            "layout": "vertical",
            "justify": "center",
            "flex": "fill",
            "padding": [0, 40],
            "children": [
              {
                "name": "logoFrame",
                "shape": "roundedRect",
                "cornerRadius": 16,
                "size": 56,
                "bg": "bg-card",
                "border": true,
                "shadow": true,
                "children": ["globeIcon"]
              },
              {
                "name": "titleBlock",
                "layout": "vertical",
                "children": [
                  { "name": "title", "element": "heading", "text": "ACP Browser Client", "fontSize": 18, "fontWeight": "700", "color": "text-primary" },
                  { "name": "subtitle", "element": "text", "text": "Connect AI agents to your browser", "fontSize": 13, "color": "text-secondary" }
                ]
              },
              {
                "name": "steps",
                "layout": "vertical",
                "gap": 20,
                "children": [
                  {
                    "name": "step1",
                    "layout": "horizontal",
                    "children": [
                      { "name": "stepNumber", "shape": "circle", "text": "1", "bg": "accent" },
                      { "name": "stepContent", "layout": "vertical", "children": [
                        { "name": "stepTitle", "text": "Start Proxy Server", "fontWeight": "600" },
                        { "name": "stepDesc", "text": "Run the proxy server to bridge your browser with AI agents" },
                        { "name": "codeBlock", "element": "code", "text": "npx @anthropic-ai/acp-browser-proxy", "bg": "bg-input", "cornerRadius": 8 }
                      ]}
                    ]
                  },
                  {
                    "name": "step2",
                    "layout": "horizontal",
                    "children": [
                      { "name": "stepNumber", "shape": "circle", "text": "2", "bg": "accent" },
                      { "name": "stepContent", "layout": "vertical", "children": [
                        { "name": "stepTitle", "text": "Select Agent", "fontWeight": "600" },
                        { "name": "stepDesc", "text": "Choose an AI agent from the dropdown above" }
                      ]}
                    ]
                  },
                  {
                    "name": "step3",
                    "layout": "horizontal",
                    "children": [
                      { "name": "stepNumber", "shape": "circle", "text": "3", "bg": "accent" },
                      { "name": "stepContent", "layout": "vertical", "children": [
                        { "name": "stepTitle", "text": "Start Chatting", "fontWeight": "600" },
                        { "name": "stepDesc", "text": "Send a message, attach page content, or use / shortcuts" }
                      ]}
                    ]
                  }
                ]
              },
              {
                "name": "helpText",
                "layout": "horizontal",
                "justify": "center",
                "children": [
                  { "name": "helpLabel", "text": "Need help? Check the" },
                  { "name": "helpLink", "element": "link", "text": "documentation", "color": "accent" }
                ]
              }
            ]
          },
          {
            "name": "InputBar",
            "layout": "vertical",
            "bg": "bg-card",
            "border": true,
            "shadow": true,
            "children": [
              {
                "name": "inputRow",
                "layout": "horizontal",
                "padding": [8, 12],
                "children": [
                  { "name": "attachBtn", "element": "iconButton", "icon": "paperclip" },
                  { "name": "screenshotBtn", "element": "iconButton", "icon": "camera" },
                  { "name": "messageInput", "element": "input", "placeholder": "Waiting for connection...", "flex": "fill" },
                  { "name": "sendBtn", "element": "iconButton", "icon": "send", "color": "accent" }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "checks": {
    "structural": [
      { "id": "S01", "desc": "Has TopBar with agent selector and action icons", "weight": 8 },
      { "id": "S02", "desc": "Has centered main content area", "weight": 6 },
      { "id": "S03", "desc": "Has logo/icon in rounded container with border and shadow", "weight": 5 },
      { "id": "S04", "desc": "Has app title 'ACP Browser Client'", "weight": 4 },
      { "id": "S05", "desc": "Has subtitle text", "weight": 3 },
      { "id": "S06", "desc": "Has exactly 3 numbered steps", "weight": 8 },
      { "id": "S07", "desc": "Step 1 contains a code/command block", "weight": 5 },
      { "id": "S08", "desc": "Has help text with documentation link", "weight": 3 },
      { "id": "S09", "desc": "Has bottom input bar with message input", "weight": 6 },
      { "id": "S10", "desc": "Input bar has attachment and send buttons", "weight": 5 }
    ],
    "layout": [
      { "id": "L01", "desc": "Root uses vertical flex/column layout", "weight": 5 },
      { "id": "L02", "desc": "TopBar uses horizontal flex with space-between", "weight": 4 },
      { "id": "L03", "desc": "Main content area is vertically centered (flex-1 + items-center)", "weight": 5 },
      { "id": "L04", "desc": "Steps use consistent vertical spacing", "weight": 3 },
      { "id": "L05", "desc": "Each step uses horizontal layout (number + content)", "weight": 4 },
      { "id": "L06", "desc": "Input bar anchored to bottom", "weight": 4 }
    ],
    "visual": [
      { "id": "V01", "desc": "Dark background (close to #0f1117)", "weight": 5 },
      { "id": "V02", "desc": "Card backgrounds distinct from page bg (close to #1e2538)", "weight": 4 },
      { "id": "V03", "desc": "Uses green/teal accent color (close to #6ee7b7)", "weight": 5 },
      { "id": "V04", "desc": "Has border/stroke on card elements", "weight": 3 },
      { "id": "V05", "desc": "Has shadow effects", "weight": 2 },
      { "id": "V06", "desc": "Connection status dot visible", "weight": 2 },
      { "id": "V07", "desc": "Step numbers styled as colored circles/badges", "weight": 3 }
    ],
    "typography": [
      { "id": "T01", "desc": "Uses DM Sans or similar sans-serif font", "weight": 2 },
      { "id": "T02", "desc": "Title has larger/bolder font than body", "weight": 2 },
      { "id": "T03", "desc": "Muted/secondary text uses lighter color", "weight": 2 },
      { "id": "T04", "desc": "Code block uses monospace font", "weight": 2 }
    ]
  }
}
